# ============================================================
# .env.example — Copiez ce fichier en .env et remplissez-le :
#   cp .env.example .env && chmod 600 .env
# Ne committez JAMAIS le fichier .env (il est dans .gitignore)
# ============================================================

# Token GitHub (classic) — scopes nécessaires :
#   repo              → créer / lire / pousser les dépôts
#   admin:public_key  → install_github.sh (enregistrement de la clé SSH)
#   delete_repo       → uniquement si vous utilisez delete_repos.sh
GITHUB_TOKEN=ghp_VOTRE_TOKEN_ICI

# Nom d'utilisateur GitHub
GITHUB_USER=votre-identifiant-github

# Chemin des dépôts sur le serveur OVH
OVH_BASE_PATH=/var/www/html

# Chemin des dépôts en local (WSL)
LOCAL_BASE_PATH=/home/vous/projets

# Visibilité des dépôts créés sur GitHub (true = privé, recommandé)
REPO_PRIVATE=true

# Dossiers à ne JAMAIS synchroniser (séparés par des espaces, jokers autorisés)
# Les dossiers cachés et _backups_* sont toujours ignorés.
EXCLUDE_REPOS="phpmyadmin nextcloud"

# Où sync_initial.sh range ses sauvegardes (hors du webroot !)
BACKUP_PATH=/home/vous/git_backups

# Taille max d'un fichier versionné, en octets (défaut 100 Mo)
FILE_SIZE_LIMIT=104857600
